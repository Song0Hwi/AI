# OpenAI API 설정 (필수)
OPENAI_API_KEY=sk-proj-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Firebase Firestore 설정 (필수 - 서비스 계정 JSON 파일 경로 또는 JSON 원문 문자열)
FIREBASE_SERVICE_ACCOUNT_JSON=./serviceAccountKey.json

# 프론트엔드/백엔드 연동 및 CORS 설정
API_BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,https://your-frontend.vercel.app
PORT=8000
